# =============================================================
# CcVault Pipeline · API Keys & Secrets
# =============================================================
# 1. 复制本文件为 .env:  cp .env.template .env
# 2. 填入你的真实 key
# 3. .env 已在 .gitignore 中，绝对不会被 commit
# 4. 所有脚本都通过 os.getenv("KEY_NAME") 读取
# =============================================================

# --- Claude (Sonnet 4.6 + Opus 4.7) ---
# 第三方代充 $300 面值 ≈ $95 真实额度
# 走 OpenAI-compatible endpoint 或 Anthropic 原生 endpoint
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://kuaipao.ai   # 若代充用自己的端点则改

# 默认模型（Pipeline 按阶段自动选择，不需要改）
CLAUDE_SONNET_MODEL=claude-sonnet-4-6
CLAUDE_OPUS_MODEL=claude-opus-4-7

# --- DeepSeek V3 ---
# 走 DeepSeek 官方 API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat                  # DeepSeek V3 聊天模型

# --- 百度云 OCR（可选，处理扫描 PDF）---
BAIDU_OCR_APP_ID=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# --- Pipeline 控制参数 ---
PIPELINE_CONCURRENCY=10                       # DeepSeek 并发线程数
PIPELINE_MAX_RETRY=3                          # API 失败重试次数
PIPELINE_COST_LIMIT_USD=100                   # 超过此金额自动停机
PIPELINE_LOG_LEVEL=INFO                       # DEBUG/INFO/WARN/ERROR

# --- Vault 路径 ---
VAULT_ROOT=D:/CcVault
RAW_SOURCE_DIR=D:/CcVault/00_Raw/标准库
WIKI_OUTPUT_DIR=D:/CcVault/01_Wiki
STAGING_DIR=D:/CcVault/99_SystemScripts/auto_reg_index/.staging
